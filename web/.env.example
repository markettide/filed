# Resend: OTP, welcome, contact form
RESEND_API_KEY=replace-with-a-resend-api-key
RESEND_FROM=Market Tide <brief@markettide.in>
REPLY_TO_EMAIL=market.tide27@gmail.com

# Kit: newsletter audience, Daily Brief broadcasts, and all trial reminders.
KIT_API_KEY=replace-with-a-kit-v4-api-key
KIT_FROM_EMAIL=brief@markettide.in

# Existing storage/authentication
MONGODB_URI=replace-with-your-mongodb-uri
MONGODB_DB=market_tide
BRIEF_WORKER_SECRET=replace-with-a-shared-worker-secret
AUTH_SECRET=replace-with-a-long-random-secret
# Change this value whenever every reader must be signed out across deployments.
SESSION_VERSION=premium-trial-2026-09-19
SEND_WELCOME_EMAILS=false

# Telegram watchlist alerts. Create the bot with @BotFather. The bot name is
# the username without the leading @. Use the same CRON_SECRET in GitHub.
TELEGRAM_BOT_TOKEN=replace-with-the-botfather-token
TELEGRAM_BOT_NAME=replace-with-the-bot-username
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
# Private operations dashboard
ADMIN_PATH_TOKEN=replace-with-a-long-random-url-token
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-separate-long-random-secret

# Cashfree Payment Gateway. Use TEST_ credentials with sandbox locally.
CASHFREE_CLIENT_ID=replace-with-cashfree-test-app-id
CASHFREE_CLIENT_SECRET=replace-with-cashfree-test-secret-key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
APP_BASE_URL=http://localhost:3000
